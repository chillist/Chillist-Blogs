---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = '关于 Chillist';
const description = '关于 Chillist，以及这个博客记录的学习、实践与成长。';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const permalink = new URL(`${base}/about`, Astro.site).href;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <div class="about-container">
    <section class="about-hero">
      <div class="about-copy">
        <h1>关于我</h1>
        <p>你好，我是 <strong>Chillist</strong>。我喜欢把复杂的问题拆开，在学习和实践中找到答案，再把真正有用的部分记录下来。</p>
        <p>这个博客主要记录我在深度学习、Java 与软件工程实践中的学习笔记和项目复盘。从 CNN 到 RPC，从一个想法到可以运行的项目，我希望在这里留下代码之外的思考、踩过的坑和做出选择的理由。</p>
      </div>

      <figure class="about-image">
        <img src={`${base}/assets/about-illustration.webp`} alt="笔记本插画" width="420">
      </figure>
    </section>

    <section class="about-details">
      <div>
        <h2>我在这里写什么</h2>
        <ul>
          <li>深度学习中的概念、实验与复现过程</li>
          <li>Java、后端开发与工程化实践</li>
          <li>个人项目从设计、实现到复盘的完整过程</li>
          <li>学习方法与阶段性的成长记录</li>
        </ul>
      </div>

      <div class="about-note">
        <p>我不希望这里只是一份“完成了什么”的清单，更希望它能回答：为什么这样做，哪里做得不够好，以及下一次可以怎样做得更好。</p>
        <h2>找到我</h2>
        <p>你可以在 GitHub 上找到我：<a href="https://github.com/chillist" target="_blank" rel="noopener">@Chillist</a>。</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-container {
    margin: 2em auto;
    max-width: 1200px;
    width: 100%;
  }

  .about-hero {
    align-items: center;
    display: grid;
    gap: clamp(3em, 8vw, 7em);
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    min-height: 420px;
  }

  .about-copy h1 {
    margin-top: 0;
  }

  .about-image {
    margin: 0;
    text-align: center;
  }

  .about-image img {
    border-radius: 8px;
    display: block;
    margin: 0 auto;
    width: min(100%, 420px);
  }

  .about-details {
    display: grid;
    gap: clamp(3em, 8vw, 7em);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(2em, 5vw, 4em);
  }

  .about-details h2 {
    margin-top: 0;
  }

  .about-note {
    align-self: center;
  }

  @media (max-width: 800px) {
    .about-container {
      margin-top: 0;
    }

    .about-hero,
    .about-details {
      gap: 2em;
      grid-template-columns: 1fr;
    }

    .about-hero {
      min-height: auto;
    }

    .about-image img {
      max-width: 320px;
    }
  }
</style>
