---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate.js';

const title = 'Blog';
const description = 'Latest articles.';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const permalink = new URL(`${base}/blog`, Astro.site).href;

let allPosts = await getCollection('posts')
allPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <div class="blog-container">
    <h1>Blog</h1>
    <div class="post-grid">
      {allPosts.map((post) => {
        const href = `${base}/blog/${post.data.slug}`;
        return (
          <article class="post-item">
            <h2>
              <a href={href}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <div class="post-item-footer">
              <span class="post-item-date">— {formatDate(post.data.publishDate)}</span>
            </div>
            <hr />
          </article>
        )
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .blog-container {
    margin: 2em auto;
    max-width: 1200px;
    width: 100%;
  }

  .blog-container > h1 {
    margin-top: 0;
  }

  .post-grid {
    display: grid;
    gap: 0 clamp(3em, 8vw, 7em);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .post-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  h2,
  .post-item-footer {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .post-item h2 {
    margin-top: 0;
  }

  .post-item-footer {
    margin-top: auto;
  }

  .post-item-date {
    color: var(--text-secondary);
    text-align: left;
    text-transform: uppercase;
    margin-right: 16px;
  }

  hr {
    margin: 3em 0;
    width: 100%;
  }

  @media (max-width: 800px) {
    .blog-container {
      margin-top: 0;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
