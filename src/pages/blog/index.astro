---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate.js';

const title = 'Blog';
const description = 'Latest articles.';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const permalink = new URL(`${base}/blog`, Astro.site).href;

let allPosts = await getCollection('posts')
allPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <div class="blog-container">
    <h1>Blog</h1>
    <div class="blog-layout" data-blog-layout>
      <aside class="post-toc" aria-labelledby="post-toc-title">
        <div class="post-toc-content" id="post-toc-content">
          <h2 id="post-toc-title">文章目录</h2>
          <nav aria-label="全部博客文章">
            <ul>
              {allPosts.map((post) => {
                return (
                  <li>
                    <a href={`${base}/blog/${post.data.slug}`}>
                      {post.data.title}
                    </a>
                    <time datetime={new Date(post.data.publishDate).toISOString()}>
                      {formatDate(post.data.publishDate)}
                    </time>
                  </li>
                )
              })}
            </ul>
          </nav>
        </div>

        <button
          class="post-toc-toggle"
          type="button"
          title="收起文章目录"
          aria-label="收起文章目录"
          aria-controls="post-toc-content"
          aria-expanded="true"
          data-post-toc-toggle
        >
          <span aria-hidden="true">←</span>
        </button>
      </aside>

      <div class="post-grid">
        {allPosts.map((post) => {
          const href = `${base}/blog/${post.data.slug}`;
          return (
            <article class="post-item">
              <h2>
                <a href={href}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
              <div class="post-item-footer">
                <span class="post-item-date">— {formatDate(post.data.publishDate)}</span>
              </div>
              <hr />
            </article>
          )
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-container {
    margin: 2em auto;
    max-width: 1200px;
    width: 100%;
  }

  .blog-container > h1 {
    margin-top: 0;
  }

  .blog-layout {
    align-items: start;
    display: grid;
    gap: clamp(2em, 4vw, 3.5em);
    grid-template-columns: 260px minmax(0, 1fr);
    transition: grid-template-columns 0.28s ease, gap 0.28s ease;
  }

  .blog-layout.toc-collapsed {
    gap: 1.5em;
    grid-template-columns: 52px minmax(0, 1fr);
  }

  .post-toc {
    align-self: start;
    background: var(--background-body);
    border: 1px solid color-mix(in srgb, var(--text-secondary) 22%, transparent);
    border-radius: 14px;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--text-main) 8%, transparent);
    box-sizing: border-box;
    overflow: hidden;
    padding: 1rem 1rem 4.5rem;
    position: sticky;
    top: 2em;
    transition: padding 0.28s ease, width 0.28s ease;
    width: 100%;
  }

  .post-toc-content {
    opacity: 1;
    transition: opacity 0.16s ease;
    visibility: visible;
  }

  .toc-collapsed .post-toc {
    height: 52px;
    padding: 7px;
  }

  .toc-collapsed .post-toc-content {
    height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    visibility: hidden;
  }

  .post-toc h2 {
    font-size: 1.15rem;
    margin: 0 0 0.65rem 0.65rem;
  }

  .post-toc ul {
    --toc-item-height: 4.75rem;
    list-style: none;
    margin: 0;
    max-height: calc(var(--toc-item-height) * 6);
    overflow-y: auto;
    padding: 0 0.35rem 0 0;
    scrollbar-color: color-mix(in srgb, var(--text-secondary) 35%, transparent) transparent;
    scrollbar-width: thin;
  }

  .post-toc ul::-webkit-scrollbar {
    width: 5px;
  }

  .post-toc ul::-webkit-scrollbar-track {
    background: transparent;
  }

  .post-toc ul::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--text-secondary) 28%, transparent);
    border-radius: 999px;
  }

  .post-toc li {
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    height: var(--toc-item-height);
    justify-content: center;
    margin: 0;
    padding: 0.4rem 0.65rem;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .post-toc li:hover {
    background: color-mix(in srgb, var(--primary-color) 11%, transparent);
    transform: translateX(3px);
  }

  .post-toc a {
    display: -webkit-box;
    font-size: 15px;
    font-family: var(--font-family-sans);
    font-weight: 600;
    line-height: 1.35;
    overflow: hidden;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-toc time {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.25;
    margin-top: 0.3rem;
    opacity: 0.78;
    text-transform: uppercase;
  }

  .post-toc-toggle {
    align-items: center;
    background: color-mix(in srgb, var(--primary-color) 12%, var(--background-body));
    border: 1px solid color-mix(in srgb, var(--primary-color) 30%, transparent);
    border-radius: 50%;
    color: var(--text-main);
    cursor: pointer;
    display: flex;
    font: 600 18px/1 var(--font-family-sans);
    height: 36px;
    justify-content: center;
    margin: 0;
    padding: 0;
    position: absolute;
    bottom: 1rem;
    left: auto;
    right: 1rem;
    transition: background-color 0.18s ease, transform 0.18s ease;
    width: 36px;
  }

  .post-toc-toggle:hover {
    background: color-mix(in srgb, var(--primary-color) 22%, var(--background-body));
    transform: translateX(2px);
  }

  .post-toc-toggle:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  .toc-collapsed .post-toc-toggle {
    bottom: 7px;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
  }

  .post-grid {
    display: grid;
    gap: 0 clamp(3em, 8vw, 7em);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  h2,
  .post-item-footer {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .post-item h2 {
    margin-top: 0;
  }

  .post-item-footer {
    margin-top: auto;
  }

  .post-item-date {
    color: var(--text-secondary);
    text-align: left;
    text-transform: uppercase;
    margin-right: 16px;
  }

  hr {
    margin: 3em 0;
    width: 100%;
  }

  @media (max-width: 900px) {
    .blog-container {
      margin-top: 0;
    }

    .blog-layout {
      grid-template-columns: 1fr;
    }

    .blog-layout.toc-collapsed {
      gap: 1.5em;
      grid-template-columns: 1fr;
    }

    .post-toc {
      max-width: 260px;
      position: static;
    }

    .toc-collapsed .post-toc {
      width: 52px;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const tocStorageKey = 'chillist-blog-toc-collapsed';

  function initPostToc() {
    const layout = document.querySelector<HTMLElement>('[data-blog-layout]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-post-toc-toggle]');
    const content = document.querySelector<HTMLElement>('#post-toc-content');

    if (!layout || !toggle || !content || toggle.dataset.initialized === 'true') return;

    const setCollapsed = (collapsed: boolean) => {
      layout.classList.toggle('toc-collapsed', collapsed);
      content.setAttribute('aria-hidden', String(collapsed));
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.setAttribute('aria-label', collapsed ? '展开文章目录' : '收起文章目录');
      toggle.title = collapsed ? '展开文章目录' : '收起文章目录';
      const icon = toggle.querySelector('span');
      if (icon) icon.textContent = collapsed ? '→' : '←';
    };

    let collapsed = false;
    try {
      collapsed = localStorage.getItem(tocStorageKey) === 'true';
    } catch {
      collapsed = false;
    }

    setCollapsed(collapsed);
    toggle.dataset.initialized = 'true';
    toggle.addEventListener('click', () => {
      collapsed = !layout.classList.contains('toc-collapsed');
      setCollapsed(collapsed);
      try {
        localStorage.setItem(tocStorageKey, String(collapsed));
      } catch {
        // The control still works when storage is unavailable.
      }
    });
  }

  document.addEventListener('astro:page-load', initPostToc);
  initPostToc();
</script>
